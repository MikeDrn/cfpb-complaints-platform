# --- MinIO (raw lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_123
MINIO_ENDPOINT=http://minio:9000

# --- MongoDB (serving layer) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo
# Must repeat the same user/password as above (letters and numbers only):
MONGO_URI=mongodb://admin:change_me_mongo@mongo:27017/?authSource=admin
MONGO_DB=cfpb

# --- Project option (scope is defined in config/scope_option<N>.json) ---
OPTION_NUMBER=11

# --- Sources ---
CFPB_CSV_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip
CFPB_API_URL=https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/
LOOKBACK_DAYS=21
API_PAGE_SIZE=1000
API_PAUSE_SECONDS=0.5

# --- Spark ---
SPARK_DRIVER_MEMORY=4g
